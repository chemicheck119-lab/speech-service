FROM python:3.11-slim AS builder

ARG EMBED_WHISPER_MODEL=true
ARG WHISPER_MODEL_REPOSITORY=Systran/faster-whisper-small
ARG WHISPER_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
ARG WHISPER_MODEL_BIN_SHA256=3e305921506d8872816023e4c273e75d2419fb89b24da97b4fe7bce14170d671
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip wheel --no-cache-dir --wheel-dir /wheels . \
    && python -m pip install --no-cache-dir --no-index --find-links=/wheels \
        chemicheck119-speech
RUN case "${EMBED_WHISPER_MODEL}" in \
      true) python -m chemicheck119_speech.model_provenance \
        --repository "${WHISPER_MODEL_REPOSITORY}" \
        --revision "${WHISPER_MODEL_REVISION}" \
        --model-bin-sha256 "${WHISPER_MODEL_BIN_SHA256}" \
        --output-directory /opt/whisper-models/faster-whisper-small ;; \
      false) mkdir -p /opt/whisper-models ;; \
      *) echo "EMBED_WHISPER_MODEL must be true or false" >&2; exit 2 ;; \
    esac

FROM python:3.11-slim AS runtime

ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="케미체크119 Speech API" \
      org.opencontainers.image.source="https://github.com/chemicheck119-lab/speech-service" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}"

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CHEMICHECK119_SPEECH_API_HOST=0.0.0.0 \
    CHEMICHECK119_SPEECH_API_PORT=8080 \
    CHEMICHECK119_SPEECH_MODEL=/opt/whisper-models/faster-whisper-small \
    CHEMICHECK119_SPEECH_MODEL_PROVENANCE_MANIFEST=/opt/whisper-models/faster-whisper-small/chemicheck119-model-provenance.json \
    CHEMICHECK119_SPEECH_GIT_COMMIT=${VCS_REF} \
    CHEMICHECK119_SPEECH_DEVICE=cpu \
    CHEMICHECK119_SPEECH_COMPUTE_TYPE=int8 \
    CHEMICHECK119_SPEECH_DOWNLOAD_ROOT=/opt/whisper-models \
    CHEMICHECK119_SPEECH_LOCAL_FILES_ONLY=true \
    TMPDIR=/tmp/chemicheck119-speech

WORKDIR /app
COPY --from=builder /wheels /wheels
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels \
        chemicheck119-speech \
    && rm -rf /wheels \
    && useradd --create-home --uid 10001 runner \
    && mkdir -p /tmp/chemicheck119-speech /opt/whisper-models \
    && chown -R runner:runner /tmp/chemicheck119-speech /opt/whisper-models
COPY --from=builder --chown=runner:runner /opt/whisper-models /opt/whisper-models

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["chemicheck119-speech-api"]
